# Application Settings
APP_NAME="CodeLens AI"
APP_VERSION="1.0.0"
DEBUG=True

# LLM Configuration
# Options: "ollama" or "groq"
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# If using Groq:
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_api_key_here

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
